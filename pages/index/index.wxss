.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.title-container {
  text-align: center;
  margin-bottom: 40px;
}

.title {
  font-size: 28px;
  font-weight: bold;
  color: #333;
}

.upload-container, .position-container, .action-container {
  width: 100%;
  margin-bottom: 25px;
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 150px;
  border: 2px dashed #dcdfe6;
  border-radius: 10px;
  background-color: #fff;
  cursor: pointer;
  transition: border-color 0.3s;
}

.upload-box:hover {
  border-color: #007aff;
}

.upload-icon {
  width: 50px;
  height: 50px;
  margin-bottom: 10px;
}

.upload-text {
  font-size: 16px;
  color: #666;
}



.tip-container {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0f7ff 0%, #e6f3ff 100%);
  border: 1px solid #d1e7ff;
  border-radius: 12px;
  padding: 12px 16px;
  margin-top: 15px;
  box-shadow: 0 2px 8px rgba(0, 122, 255, 0.08);
}

.tip-icon {
  margin-right: 8px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bulb-icon {
  width: 18px;
  height: 18px;
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  position: relative;
  box-shadow: 0 2px 8px rgba(255, 215, 0, 0.3);
  animation: pulse 2s infinite;
}

.bulb-icon::before {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 50%;
  transform: translateX(-50%);
  width: 6px;
  height: 8px;
  background: #ffd700;
  border-radius: 0 0 3px 3px;
}

.bulb-icon::after {
  content: '';
  position: absolute;
  top: 2px;
  left: 50%;
  transform: translateX(-50%);
  width: 2px;
  height: 2px;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 0 4px rgba(255, 255, 255, 0.8);
}

.upload-tip {
  font-size: 14px;
  color: #2c5aa0;
  font-weight: 500;
  line-height: 1.5;
  text-align: left;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    box-shadow: 0 2px 8px rgba(255, 215, 0, 0.3);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 4px 16px rgba(255, 215, 0, 0.5);
  }
  100% {
    transform: scale(1);
    box-shadow: 0 2px 8px rgba(255, 215, 0, 0.3);
  }
}

.position-input {
  width: 100%;
  height: 50px;
  line-height: 50px;
  padding: 0 15px;
  border: 1px solid #ddd;
  border-radius: 10px;
  font-size: 16px;
  box-sizing: border-box;
}

.position-input:focus {
  border-color: #007aff;
  box-shadow: 0 0 0 2px rgba(0, 122, 255, 0.2);
}



.start-button {
  width: 100%;
  height: 50px;
  border-radius: 10px;
  background-color: #007aff;
  color: #fff;
  font-size: 18px;
  font-weight: bold;
  /* 使用 flex 居中 */
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 移除小程序 button 默认边框 */
.start-button::after {
  border: none;
}

.start-button[disabled] {
  background-color: #cce4ff;
  color: #fff;
}

.history-button {
  width: 100%;
  height: 50px;
  margin-top: 15px;
  border-radius: 10px;
  background-color: #fff;
  color: #007aff;
  font-size: 18px;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 1px solid #007aff;
}

.history-button::after {
  border: none;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #aaa;
  width: 80%;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.usermotto {
  margin-top: 200px;
}

.avatar-wrapper {
  padding: 0;
  width: 56px !important;
  border-radius: 8px;
  margin-top: 40px;
  margin-bottom: 40px;
}

.avatar {
  display: block;
  width: 56px;
  height: 56px;
}

.nickname-wrapper {
  display: flex;
  width: 100%;
  padding: 16px;
  box-sizing: border-box;
  border-top: .5px solid rgba(0, 0, 0, 0.1);
  border-bottom: .5px solid rgba(0, 0, 0, 0.1);
  color: black;
}

.nickname-label {
  width: 105px;
}

.nickname-input {
  flex: 1;
}
