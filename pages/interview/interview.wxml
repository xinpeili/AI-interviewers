<view class="interview-container">
  <view class="progress-container">
    <text class="progress-text">第 {{questionCount}} 问</text>
  </view>

  <view class="question-container" wx:if="{{currentQuestion}}">
    <text class="question-text">{{currentQuestion.title}}</text>
    <view class="difficulty-container">
      <text class="difficulty-label">难度</text>
      <view class="stars">
        <image class="star" wx:for="{{5}}" wx:key="index" src="{{index < currentQuestion.difficulty ? '/images/star_filled.svg' : '/images/star_empty.svg'}}"></image>
      </view>
    </view>
  </view>

  <view class="answer-container">
    <textarea class="answer-textarea" placeholder="请输入你的回答..." value="{{userAnswer}}" bindinput="onAnswerInput" maxlength="5000"></textarea>
  </view>

  <view class="action-container">
    <button class="next-button" bindtap="nextQuestion" disabled="{{!userAnswer || isSubmitting}}">{{isSubmitting ? '思考中...' : '下一题'}}</button>
  </view>
</view>